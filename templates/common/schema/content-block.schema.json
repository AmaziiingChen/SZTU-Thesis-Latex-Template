{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu.example/schema/common/content-block.schema.json",
  "title": "深圳技术大学过程文档公共内容块",
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 5000},
        "script": {"enum": ["normal", "sub", "super"]},
        "italic": {"type": "boolean"},
        "bold": {"type": "boolean"}
      }
    },
    "richParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs"],
      "properties": {
        "type": {"const": "paragraph"},
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/run"}
        }
      }
    },
    "paragraph": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 5000},
        {"$ref": "#/$defs/richParagraph"}
      ]
    },
    "listLevel4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"enum": ["ordered_list", "unordered_list"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "marker": {"type": "string", "minLength": 1, "maxLength": 20},
              "content": {"$ref": "#/$defs/paragraph"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unordered_list"}}},
          "then": {"properties": {"items": {"items": {"not": {"required": ["marker"]}}}}}
        }
      ]
    },
    "listLevel3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"enum": ["ordered_list", "unordered_list"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "marker": {"type": "string", "minLength": 1, "maxLength": 20},
              "content": {"$ref": "#/$defs/paragraph"},
              "children": {"$ref": "#/$defs/listLevel4"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unordered_list"}}},
          "then": {"properties": {"items": {"items": {"not": {"required": ["marker"]}}}}}
        }
      ]
    },
    "listLevel2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"enum": ["ordered_list", "unordered_list"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "marker": {"type": "string", "minLength": 1, "maxLength": 20},
              "content": {"$ref": "#/$defs/paragraph"},
              "children": {"$ref": "#/$defs/listLevel3"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unordered_list"}}},
          "then": {"properties": {"items": {"items": {"not": {"required": ["marker"]}}}}}
        }
      ]
    },
    "listLevel1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"enum": ["ordered_list", "unordered_list"]},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "marker": {"type": "string", "minLength": 1, "maxLength": 20},
              "content": {"$ref": "#/$defs/paragraph"},
              "children": {"$ref": "#/$defs/listLevel2"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "unordered_list"}}},
          "then": {"properties": {"items": {"items": {"not": {"required": ["marker"]}}}}}
        }
      ]
    },
    "orderedList": {
      "allOf": [
        {"$ref": "#/$defs/listLevel1"},
        {"properties": {"type": {"const": "ordered_list"}}}
      ]
    },
    "unorderedList": {
      "allOf": [
        {"$ref": "#/$defs/listLevel1"},
        {"properties": {"type": {"const": "unordered_list"}}}
      ]
    },
    "listBlock": {
      "$ref": "#/$defs/listLevel1"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "alt"],
      "properties": {
        "type": {"const": "image"},
        "id": {
          "type": "string",
          "pattern": "^fig-[A-Za-z0-9_-]{8,96}$"
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "alt": {"type": "string", "minLength": 1, "maxLength": 500},
        "chapter": {"type": "integer", "minimum": 1, "maximum": 99},
        "width_mm": {"type": "number", "minimum": 20, "maximum": 146},
        "caption": {"$ref": "#/$defs/paragraph"},
        "source_citation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:.+/-]+$"
        }
      }
    },
    "figureGroupItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "alt": {"type": "string", "minLength": 1, "maxLength": 500},
        "caption": {"$ref": "#/$defs/paragraph"}
      }
    },
    "figureGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items", "caption"],
      "properties": {
        "type": {"const": "figure_group"},
        "id": {
          "type": "string",
          "pattern": "^fig-[A-Za-z0-9_-]{8,96}$"
        },
        "chapter": {"type": "integer", "minimum": 1, "maximum": 99},
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/figureGroupItem"}
        },
        "caption": {"$ref": "#/$defs/paragraph"},
        "source_citation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:.+/-]+$"
        }
      }
    },
    "dataTableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header"],
      "properties": {
        "header": {"$ref": "#/$defs/paragraph"},
        "width_weight": {"type": "number", "minimum": 0.25, "maximum": 10},
        "alignment": {"enum": ["left", "center", "right"]}
      }
    },
    "dataTableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells"],
      "properties": {
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/paragraph"}
        }
      }
    },
    "dataTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "rows"],
      "properties": {
        "type": {"const": "data_table"},
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/dataTableColumn"}
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {"$ref": "#/$defs/dataTableRow"}
        },
        "caption": {"$ref": "#/$defs/paragraph"}
      }
    },
    "textContentBlock": {
      "oneOf": [
        {"$ref": "#/$defs/paragraph"},
        {"$ref": "#/$defs/listBlock"},
        {"$ref": "#/$defs/figureGroup"},
        {"$ref": "#/$defs/dataTable"}
      ]
    },
    "contentBlock": {
      "oneOf": [
        {"$ref": "#/$defs/paragraph"},
        {"$ref": "#/$defs/listBlock"},
        {"$ref": "#/$defs/image"},
        {"$ref": "#/$defs/figureGroup"},
        {"$ref": "#/$defs/dataTable"}
      ]
    }
  }
}
