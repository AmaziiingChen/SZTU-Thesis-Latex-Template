{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sztu.example/schema/common/content-block.schema.json",
  "title": "深圳技术大学过程文档公共内容块",
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 5000},
        "script": {"enum": ["normal", "sub", "super"]},
        "italic": {"type": "boolean"},
        "bold": {"type": "boolean"}
      }
    },
    "richParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs"],
      "properties": {
        "type": {"const": "paragraph"},
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/run"}
        }
      }
    },
    "paragraph": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 5000},
        {"$ref": "#/$defs/richParagraph"}
      ]
    },
    "orderedListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "marker": {"type": "string", "minLength": 1, "maxLength": 20},
        "content": {"$ref": "#/$defs/paragraph"}
      }
    },
    "orderedList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {"const": "ordered_list"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/orderedListItem"}
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "alt"],
      "properties": {
        "type": {"const": "image"},
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "alt": {"type": "string", "minLength": 1, "maxLength": 500},
        "width_mm": {"type": "number", "minimum": 20, "maximum": 146},
        "caption": {"$ref": "#/$defs/paragraph"}
      }
    },
    "contentBlock": {
      "oneOf": [
        {"$ref": "#/$defs/paragraph"},
        {"$ref": "#/$defs/orderedList"},
        {"$ref": "#/$defs/image"}
      ]
    }
  }
}
