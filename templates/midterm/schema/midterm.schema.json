{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midterm.schema.json",
  "title": "深圳技术大学本科毕业论文（设计）中期检查表数据",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "sections"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_name",
        "college",
        "major",
        "class_name",
        "advisor",
        "check_date",
        "title"
      ],
      "properties": {
        "student_name": {"type": "string", "minLength": 1, "maxLength": 20},
        "college": {"type": "string", "minLength": 1, "maxLength": 50},
        "major": {"type": "string", "minLength": 1, "maxLength": 50},
        "class_name": {"type": "string", "minLength": 1, "maxLength": 30},
        "advisor": {"type": "string", "minLength": 1, "maxLength": 30},
        "check_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "title": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 90},
            {"$ref": "#/$defs/richParagraph"}
          ]
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "main_research_content", "progress"],
      "properties": {
        "numbering_style": {
          "enum": [
            "chinese_hierarchy",
            "chapter_hierarchy",
            "chapter_section_hierarchy",
            "part_chapter_section_hierarchy",
            "decimal_hierarchy"
          ]
        },
        "directory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 150,
          "items": {"$ref": "#/$defs/outlineItem"}
        },
        "main_research_content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/contentBlock"}
        },
        "progress": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/contentBlock"}
        }
      }
    }
  },
  "$defs": {
    "richParagraph": {
      "$ref": "../../common/schema/content-block.schema.json#/$defs/richParagraph"
    },
    "paragraph": {
      "$ref": "../../common/schema/content-block.schema.json#/$defs/paragraph"
    },
    "contentBlock": {
      "$ref": "../../common/schema/content-block.schema.json#/$defs/contentBlock"
    },
    "outlineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "title"],
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 6},
        "number": {"type": "string", "minLength": 1, "maxLength": 20},
        "title": {"$ref": "#/$defs/paragraph"}
      }
    }
  }
}
